{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(count_over_time({service=\"api\"} | json | msg=\"organization.request.signal\" | workspace=\"Platform\" | module=\"workspace\" [$__range]))", "refId": "A" }],
      "title": "Organization requests",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(count_over_time({service=\"api\"} | json | msg=\"organization.request.signal\" | outcome=\"error\" [$__range])) / clamp_min(sum(count_over_time({service=\"api\"} | json | msg=\"organization.request.signal\" [$__range])), 1)", "refId": "A" }],
      "title": "Organization error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "quantile_over_time(0.95, {service=\"api\"} | json | msg=\"organization.request.signal\" | unwrap durationMs | __error__=\"\" [$__range])", "refId": "A" }],
      "title": "Organization request latency p95",
      "type": "timeseries"
    }
  ],

{
  "name": "nut-shyll",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-native software foundation monorepo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "prepare": "node tooling/scripts/install-git-hooks.mjs",
    "hooks:install": "node tooling/scripts/install-git-hooks.mjs",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r --if-present run build",
    "validate:architecture": "node tooling/scripts/validate-architecture-boundaries.mjs",
    "secrets:scan": "node tooling/scripts/secret-scan.mjs",
    "commit-msg:check": "node tooling/git-hooks/commit-msg",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run validate:architecture && pnpm run secrets:scan"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}

{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["logging", "mongodb", "types"],
  "externalDependencies": ["dotenv", "express", "zod"],
  "capabilities": ["http-api", "health", "mongodb-integration"],
  "tasks": {
    "dev": { "command": "npm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI"], "cache": false },
    "build": { "command": "npm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "npm test", "cache": false },
    "lint": { "command": "npm run lint", "cache": false },
    "typecheck": { "command": "npm run typecheck", "cache": false }
  }
}

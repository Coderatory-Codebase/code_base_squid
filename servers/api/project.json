{
  "name": "api",
  "type": "server",
  "description": "Primary Express API runtime.",
  "internalDependencies": ["eslint-config", "kernel", "logging", "tsconfig", "types"],
  "externalDependencies": ["bullmq", "dotenv", "express", "ioredis", "mongoose", "mongodb-memory-server", "zod"],
  "capabilities": ["http-api", "health", "mongodb-integration", "organization-dashboard", "team-management", "outbox-relay"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "environment": ["API_HOST", "API_PORT", "WEB_ORIGIN", "MONGODB_URI", "REDIS_URL", "LOG_FORMAT"], "cache": false },
    "seed:preview": { "command": "pnpm run seed:preview", "environment": ["MONGODB_URI", "PREVIEW_USER_EMAIL", "PREVIEW_USER_PASSWORD", "PREVIEW_WORKSPACE_ID"], "cache": false },
    "measure:organization-budget": { "command": "pnpm run measure:organization-budget", "cache": false },
    "measure:organization-setup-budget": { "command": "pnpm run measure:organization-setup-budget", "cache": false },
    "measure:workspace-dashboard-budget": { "command": "pnpm run measure:workspace-dashboard-budget", "cache": false },
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}

{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test features/*/*.test.ts features/*/tests/*.test.ts features/outbox/tests/*.test.ts integrations/mongodb/*/tests/*.test.ts integrations/mongodb/tests/*.test.ts integrations/redis/tests/*.test.ts kernel/tests/*.test.ts tests/entry-points.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/identity-sign-in.acceptance.test.ts tests/mongodb.test.ts tests/shutdown.test.ts",
    "test:identity-load": "tsx --test tests/identity-sign-in.load.test.ts tests/identity-principal.load.test.ts",
    "perf:identity-profile": "tsx scripts/seed.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/kernel": "workspace:*",
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "bullmq": "6.3.9",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.10.1",
    "openid-client": "6.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

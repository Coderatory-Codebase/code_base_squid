{
  "name": "logging",
  "type": "package",
  "description": "Reusable structured application and HTTP logging capability.",
  "internalDependencies": [],
  "externalDependencies": ["morgan", "pino"],
  "capabilities": ["application-logging", "http-logging"],
  "tasks": {
    "build": { "command": "npm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "npm test", "cache": false },
    "lint": { "command": "npm run lint", "cache": false },
    "typecheck": { "command": "npm run typecheck", "cache": false }
  }
}

{
  "name": "ui",
  "type": "package",
  "description": "Reusable shadcn-based UI primitives and generic compositions.",
  "internalDependencies": [],
  "externalDependencies": ["@radix-ui/react-slot", "class-variance-authority", "clsx", "react", "tailwind-merge"],
  "capabilities": ["shadcn-ui", "generic-ui", "react-components"],
  "tasks": {
    "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}

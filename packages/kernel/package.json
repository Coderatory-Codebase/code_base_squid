{
  "name": "@workspace/kernel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build",
    "test": "tsx --test tests/*.test.ts tests/kernel.test.ts",
    "check:contracts": "tsx scripts/check-event-contract-compatibility.ts",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "ulid": "^3.0.2" },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "@types/node": "^22.20.3",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

#!/usr/bin/env node
// Git commit-msg hook. Installed via `core.hooksPath` — see
// tooling/scripts/install-git-hooks.mjs. Validates the commit subject
// against the convention defined in tooling/scripts/commit-message-rules.mjs
// (also used by CI, so local and CI enforce the same rule — see
// .agent/instructions/git-governance.md -> "Local and CI parity").
//
// Bypassable with `git commit --no-verify` — that's expected, not a bug:
// this hook is fast local feedback, not the enforcement boundary. See
// SPEC-009 -> "Hooks are not the final authority".
import { readFileSync } from "node:fs";
import { validateCommitMessage } from "../scripts/commit-message-rules.mjs";

const messageFile = process.argv[2];

if (!messageFile) {
  console.error("commit-msg: no commit message file path provided.");
  process.exit(1);
}

const message = readFileSync(messageFile, "utf8");
const result = validateCommitMessage(message);

if (!result.ok) {
  console.error(`\ncommit-msg: rejected\n\n${result.reason}\n`);
  process.exit(1);
}

process.exit(0);

#!/usr/bin/env node
// Git pre-commit hook. Installed via `core.hooksPath` — see
// tooling/scripts/install-git-hooks.mjs. Fast, deterministic checks
// scoped to staged files only — see SPEC-009 -> "Staged-file scoping
// (M14)". Calls the repository's own central tooling rather than
// reimplementing its logic (SPEC-009 -> "Avoid duplicated shell logic").
//
// Bypassable with `git commit --no-verify` — expected, not a bug. See
// tooling/git-hooks/commit-msg for the rationale, which applies here too.
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import path from "node:path";

// pnpm/prettier resolve to a .cmd/.ps1 shim on Windows, which
// execFileSync can't exec directly without a shell — shell:true is
// required there, and harmless on POSIX. See ADR-009 -> "Windows shell
// resolution".
const useShell = process.platform === "win32";
const gitSafeDirectory = process.cwd().replace(/\\/g, "/");

function resolveExecutable(command) {
  if (path.isAbsolute(command) && existsSync(command)) {
    return command;
  }

  const extensions = process.platform === "win32" ? [".cmd", ".exe", ".bat", ""] : [""];
  const pathDirs = (process.env.PATH ?? "").split(path.delimiter).filter(Boolean);

  for (const dir of pathDirs) {
    for (const extension of extensions) {
      const candidate = path.join(
        dir,
        command.endsWith(extension) ? command : `${command}${extension}`,
      );
      if (existsSync(candidate)) {
        return candidate;
      }
    }
  }

  if (command === "pnpm") {
    const fallbackDirs = [
      path.resolve(path.dirname(process.execPath), "..", "..", "bin", "fallback"),
      process.env.APPDATA ? path.join(process.env.APPDATA, "npm") : "",
      process.env.USERPROFILE
        ? path.join(
            process.env.USERPROFILE,
            ".cache",
            "codex-runtimes",
            "codex-primary-runtime",
            "dependencies",
            "bin",
            "fallback",
          )
        : "",
    ].filter(Boolean);

    for (const dir of fallbackDirs) {
      for (const extension of extensions) {
        const candidate = path.join(dir, `pnpm${extension}`);
        if (existsSync(candidate)) {
          return candidate;
        }
      }
    }
  }

  return command;
}

function run(command, args) {
  const resolvedCommand = resolveExecutable(command);
  const commandPath = path.dirname(resolvedCommand);
  const env = {
    ...process.env,
    PATH: [commandPath, path.dirname(process.execPath), process.env.PATH ?? ""]
      .filter(Boolean)
      .join(path.delimiter),
  };

  try {
    execFileSync(resolvedCommand, args, { stdio: "inherit", shell: useShell, env });
    return true;
  } catch (error) {
    if (error.code === "ENOENT") {
      console.error(`pre-commit: could not run "${command}": ${error.message}`);
    }
    return false;
  }
}

function stagedFiles() {
  const out = execFileSync(
    "git",
    [
      "-c",
      `safe.directory=${gitSafeDirectory}`,
      "diff",
      "--cached",
      "--name-only",
      "--diff-filter=ACM",
    ],
    {
      encoding: "utf8",
    },
  );
  return out.split("\n").filter(Boolean);
}

const staged = stagedFiles();

if (staged.length === 0) {
  process.exit(0); // nothing staged (e.g. an empty/amend commit) — nothing to check
}

// format:check runs against staged files only — unrelated pre-existing
// formatting issues elsewhere in the tree must never block an unrelated
// commit (SPEC-009 -> "Staged-file scoping (M14)"). --ignore-unknown is
// required here: unlike glob mode, prettier errors (not skips) on an
// explicit path it has no parser for (e.g. a stray extensionless file).
console.log("pre-commit: format:check (staged files)");
const formatOk = run(process.execPath, [
  path.join("node_modules", "prettier", "bin", "prettier.cjs"),
  "--check",
  "--ignore-unknown",
  ...staged,
]);

console.log("pre-commit: secrets:scan (staged files)");
const secretsOk = run(process.execPath, ["tooling/scripts/secret-scan.mjs", "--staged"]);

if (!formatOk || !secretsOk) {
  console.error(
    "\npre-commit: rejected — fix the issue(s) above, or run " +
      '"pnpm run format" for formatting.\n',
  );
  process.exit(1);
}

process.exit(0);

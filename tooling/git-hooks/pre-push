#!/usr/bin/env node
// Git pre-push hook. Installed via `core.hooksPath` — see
// tooling/scripts/install-git-hooks.mjs. Runs the full local quality
// gate — broader than pre-commit, still local feedback, not the
// authoritative gate (CI is — see SPEC-009 -> "Hooks are not the final
// authority"). Reuses the central `validate`/`format:check` commands
// rather than duplicating their logic.
//
// Bypassable with `git push --no-verify` — expected, not a bug.
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import path from "node:path";

// pnpm resolves to a .cmd/.ps1 shim on Windows, which execFileSync can't
// exec directly without a shell — shell:true is required there, and
// harmless on POSIX. See ADR-009 -> "Windows shell resolution".
const useShell = process.platform === "win32";

function resolveExecutable(command) {
  if (path.isAbsolute(command) && existsSync(command)) {
    return command;
  }

  const extensions = process.platform === "win32" ? [".cmd", ".exe", ".bat", ""] : [""];
  const pathDirs = (process.env.PATH ?? "").split(path.delimiter).filter(Boolean);

  for (const dir of pathDirs) {
    for (const extension of extensions) {
      const candidate = path.join(
        dir,
        command.endsWith(extension) ? command : `${command}${extension}`,
      );
      if (existsSync(candidate)) {
        return candidate;
      }
    }
  }

  if (command === "pnpm") {
    const fallbackDirs = [
      path.resolve(path.dirname(process.execPath), "..", "..", "bin", "fallback"),
      process.env.APPDATA ? path.join(process.env.APPDATA, "npm") : "",
      process.env.USERPROFILE
        ? path.join(
            process.env.USERPROFILE,
            ".cache",
            "codex-runtimes",
            "codex-primary-runtime",
            "dependencies",
            "bin",
            "fallback",
          )
        : "",
    ].filter(Boolean);

    for (const dir of fallbackDirs) {
      for (const extension of extensions) {
        const candidate = path.join(dir, `pnpm${extension}`);
        if (existsSync(candidate)) {
          return candidate;
        }
      }
    }
  }

  return command;
}

function run(command, args) {
  const resolvedCommand = resolveExecutable(command);
  const commandPath = path.dirname(resolvedCommand);
  const env = {
    ...process.env,
    PATH: [commandPath, path.dirname(process.execPath), process.env.PATH ?? ""]
      .filter(Boolean)
      .join(path.delimiter),
  };

  try {
    execFileSync(resolvedCommand, args, { stdio: "inherit", shell: useShell, env });
    return true;
  } catch (error) {
    if (error.code === "ENOENT") {
      console.error(`pre-push: could not run "${command}": ${error.message}`);
    }
    return false;
  }
}

console.log("pre-push: validate (lint, typecheck, test, build, architecture, secrets)");
const validateOk = run("pnpm", ["run", "--silent", "validate"]);

console.log("pre-push: format:check");
const formatOk = run("pnpm", ["run", "--silent", "format:check"]);

if (!validateOk || !formatOk) {
  console.error(
    '\npre-push: rejected — run "pnpm run validate" and ' +
      '"pnpm run format:check" locally, fix what fails, then push again.\n',
  );
  process.exit(1);
}

process.exit(0);
